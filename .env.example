# 复制本文件为 .env 后按需修改。所有公开数据源（GDELT/ReliefWeb/USGS/CISA/RSS）无需 API key。

# ---- LLM（OpenAI 兼容，换供应商只改这几项）----
ENABLE_LLM=1                       # 1=启用 0=关闭（关闭则用模板研判）
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=                       # 你的 key；留空则自动回退模板，不报错
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---- 采集开关（1=启用 0=关闭）----
ENABLE_GDELT=1                     # GDELT 全球新闻事件
ENABLE_RELIEFWEB=0                 # ReliefWeb 灾害/人道主义（需先到 reliefweb.int 注册 appname）
ENABLE_USGS=1                      # USGS 地震
ENABLE_CISA=1                      # CISA 已知被利用漏洞
ENABLE_NVD=0                       # NVD 近期 CVE（接口限流，默认关闭，建议配 NVD_API_KEY）
ENABLE_MFA=0                       # 外交部领事提醒（需自备 RSS，见 README）

# ---- GDELT ----
GDELT_QUERY=conflict OR terrorism OR earthquake OR riot OR protest OR kidnapping OR "access control" OR "video surveillance" OR "security camera" OR "perimeter security"
GDELT_TIMESPAN=1d                  # 时间窗：1d / 3d / 7d
GDELT_LIMIT=30

# ---- ReliefWeb ----
RELIEFWEB_APPNAME=security-intel-agent
RELIEFWEB_LIMIT=20

# ---- USGS 地震 ----
USGS_MIN_MAG=4.5
USGS_LIMIT=20

# ---- CISA 已知被利用漏洞 ----
CISA_LIMIT=10

# ---- NVD（可选）----
NVD_LIMIT=10
NVD_API_KEY=

# ---- RSS 信源：`URL|领域`，逗号分隔，可自行增删 ----
# 领域可选：geopolitical / terror / unrest / disaster / health / cyber / personnel / compliance
# 物理安防聚焦：通用新闻源（BBC/Al Jazeera/Guardian）用于兜底全球冲突/灾害，
# 安防行业垂直媒体用于采集视频监控/门禁/报警等产品与企业动态。
# 注意：securityworldmarket / securitymagazine / ifsecglobal / sdmmag / securitytoday
#       等媒体使用 Cloudflare 反爬，普通 RSS 无法抓取（403），已移除。
# 注意：BBC / Al Jazeera / The Guardian 在国内被墙，需配 PROXY_HTTPS 才能取到；
#       不想用代理，可在国内 IP 下删掉这三条（GDELT 已覆盖全球新闻兜底）。
RSS_FEEDS=http://feeds.bbci.co.uk/news/world/rss.xml|geopolitical,https://www.aljazeera.com/xml/rss/all.xml|geopolitical,https://www.theguardian.com/world/rss|geopolitical,https://securityjournaluk.com/feed/|personnel,https://internationalsecurityjournal.com/feed/|personnel,https://securitylinkindia.com/feed/|personnel,https://www.revistasegurancaeletronica.com.br/feed/|personnel,https://www.send2press.com/wire/technology-news/security-tech-news/feed/|personnel
RSS_LIMIT=15

# ---- 外交部提醒（可选）----
MFA_FEED=

# ---- 处理 ----
TOP_N=8                            # 每日最终上报条数（5-15 条，行业事件优先+突发事件限量）
DEDUP_DAYS=7                       # 去重窗口（天）
SEVERITY_HIGHLIGHT=4               # 「重点关注」阈值（>=4 计入）
HISTORY_FILE=output/history.json

# ---- 推送渠道（留空=关闭该渠道，自动跳过）----
WECOM_WEBHOOK=                     # 企业微信机器人 webhook 完整地址
DINGTALK_WEBHOOK=                  # 钉钉机器人 webhook 完整地址
DINGTALK_SECRET=                   # 钉钉加签密钥（可选）
FEISHU_WEBHOOK=                    # 飞书机器人 webhook 完整地址
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                         # 默认取 SMTP_USER
EMAIL_TO=                          # 收件人，逗号分隔

# ---- 网络代理（可选）：国内 IP 访问境外源用，留空=不走代理 ----
# 邮件（SMTP）不走代理；HTTP(S) 采集会自动套用此代理。
PROXY_HTTP=
PROXY_HTTPS=

# ---- 输出与调度 ----
OUTPUT_DIR=output
SCHEDULE_TIME=07:30                # 工作日定时运行时刻（24h）
LOG_LEVEL=INFO
HTTP_TIMEOUT=20
