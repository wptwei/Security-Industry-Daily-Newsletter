# 复制本文件为 .env 后按需修改。所有公开数据源（GDELT/ReliefWeb/USGS/CISA/RSS）无需 API key。

# ---- LLM（OpenAI 兼容，换供应商只改这几项）----
ENABLE_LLM=1                       # 1=启用 0=关闭（关闭则用模板研判）
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=                       # 你的 key；留空则自动回退模板，不报错
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---- 采集开关（1=启用 0=关闭）----
ENABLE_GDELT=1                     # GDELT 全球新闻事件
ENABLE_RELIEFWEB=0                 # ReliefWeb 灾害/人道主义（需先到 reliefweb.int 注册 appname）
ENABLE_USGS=1                      # USGS 地震
ENABLE_CISA=1                      # CISA 已知被利用漏洞
ENABLE_NVD=0                       # NVD 近期 CVE（接口限流，默认关闭，建议配 NVD_API_KEY）
ENABLE_MFA=0                       # 外交部领事提醒（需自备 RSS，见 README）

# ---- GDELT ----
GDELT_QUERY=conflict OR terrorism OR earthquake OR riot OR protest OR kidnapping OR "access control" OR "video surveillance" OR "security camera" OR "perimeter security"
GDELT_TIMESPAN=1d                  # 时间窗：1d / 3d / 7d
GDELT_LIMIT=30

# ---- ReliefWeb ----
RELIEFWEB_APPNAME=security-intel-agent
RELIEFWEB_LIMIT=20

# ---- USGS 地震 ----
USGS_MIN_MAG=4.5
USGS_LIMIT=20

# ---- CISA 已知被利用漏洞 ----
CISA_LIMIT=10

# ---- NVD（可选）----
NVD_LIMIT=10
NVD_API_KEY=

# ---- RSS 信源：`URL|领域`，逗号分隔，可自行增删 ----
# 领域可选：geopolitical / terror / unrest / disaster / health / cyber / personnel / compliance
# 物理安防聚焦：通用新闻源（BBC/Al Jazeera/Guardian）用于兜底全球冲突/灾害，
# 安防行业垂直媒体用于采集视频监控/门禁/报警等产品与企业动态。
# 已验证可用的直连 RSS：Security Magazine / SDM / SecurityInfoWatch / SSI /
#   Australian Security Magazine / TMA，以及原有 7 家垂直媒体。
# 仍抓不到的源（IFSEC 主站、Security Today、ASIS/SIA 等）用 Google 新闻
#   `site:` 查询或关键词查询兜底；中文门户见下方 HTML_SITES 直采。
# 注意：BBC / Al Jazeera / The Guardian 在国内被墙，需配 PROXY_HTTPS 才能取到；
#       不想用代理，可在国内 IP 下删掉这三条（GDELT 已覆盖全球新闻兜底）。
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml|geopolitical,https://www.aljazeera.com/xml/rss/all.xml|geopolitical,https://www.theguardian.com/world/rss|geopolitical,https://securityjournaluk.com/feed/|personnel,https://internationalsecurityjournal.com/feed/|personnel,https://securitylinkindia.com/feed/|personnel,https://revistasegurancaeletronica.com.br/feed/|personnel,https://www.send2press.com/wire/technology-news/security-tech-news/feed/|personnel,https://security.world/feed/|personnel,https://www.securitymagazine.com/rss/articles|personnel,https://www.sdmmag.com/rss/articles|personnel,https://www.securityinfowatch.com/__rss/website-scheduled-content.xml?input=%7B%22sectionAlias%22%3A%22home%22%7D|personnel,https://www.securitysales.com/feed/atom/|personnel,https://australiansecuritymagazine.com.au/feed/|personnel,https://tma.us/feed/|personnel,https://news.google.com/rss/search?q=%22physical+security%22&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=%22access+control%22+security&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=%22video+surveillance%22&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=%22security+camera%22&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=%22perimeter+security%22&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=site%3Asourcesecurity.com&hl=en-US&gl=US&ceid=US:en|personnel,https://news.google.com/rss/search?q=%E5%AE%89%E9%98%B2&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%E6%B5%B7%E5%BA%B7%E5%A8%81%E8%A7%86&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%E5%A4%A7%E5%8D%8E%E8%82%A1%E4%BB%BD&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%E5%AE%87%E8%A7%86&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%E5%AE%89%E9%98%B2+OR+%E8%A7%86%E9%A2%91%E7%9B%91%E6%8E%A7+OR+%E9%97%A8%E7%A6%81+OR+%E4%BA%BA%E8%84%B8%E8%AF%86%E5%88%AB&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%E5%AE%89%E9%98%B2&hl=zh-TW&gl=TW&ceid=TW:zh-Hant|personnel,https://news.google.com/rss/search?q=%28%E5%A4%A9%E5%9C%B0%E4%BC%9F%E4%B8%9A%20OR%20%E7%86%B5%E5%9F%BA%E7%A7%91%E6%8A%80%20OR%20%E6%97%B7%E8%A7%86%E7%A7%91%E6%8A%80%20OR%20%E5%95%86%E6%B1%A4%E7%A7%91%E6%8A%80%20OR%20%E4%BD%B3%E9%83%BD%E7%A7%91%E6%8A%80%20OR%20%E6%8D%B7%E9%A1%BA%E7%A7%91%E6%8A%80%29%20when%3A7d&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%28%E5%AE%89%E9%98%B2%20OR%20%E8%A7%86%E9%A2%91%E7%9B%91%E6%8E%A7%29%20%28%E4%B8%9C%E5%8D%97%E4%BA%9A%20OR%20%E4%B8%AD%E4%B8%9C%20OR%20%E5%8D%B0%E5%BA%A6%20OR%20%E6%8B%89%E7%BE%8E%29%20when%3A7d&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel,https://news.google.com/rss/search?q=%28%E5%AE%89%E5%8D%9A%E4%BC%9A%20OR%20%E5%AE%89%E9%98%B2%E5%B1%95%20OR%20%E5%AE%89%E9%98%B2%E5%B3%B0%E4%BC%9A%29%20when%3A7d&hl=zh-CN&gl=CN&ceid=CN:zh-Hans|personnel
RSS_LIMIT=15

# ---- 中文安防门户 HTML 直采（无 RSS 的服务端渲染站点，见 app/collectors/html.py）----
# 21csp=中国安防行业网(协会要闻/论坛)  afzhan=安防展览网/智慧城市网  asmag=安防知识网
HTML_SITES=21csp,afzhan,asmag
HTML_LIMIT=10                       # 每个站点最多抓取的文章数

# ---- 外交部提醒（可选）----
MFA_FEED=

# ---- 处理 ----
TOP_N=8                            # 每日最终上报条数（5-15 条，行业事件优先+突发事件限量）
DEDUP_DAYS=7                       # 去重窗口（天）
TIME_WINDOW_HOURS=72               # 新闻时间窗（小时）：72h 覆盖周末，避免周一漏掉周五行业新闻
MAX_PER_SOURCE=6                   # 单来源配额（同一 source 名最多入选条数，0=不限制，避免聚合源霸屏）
SEVERITY_HIGHLIGHT=4               # 「重点关注」阈值（>=4 计入）
HISTORY_FILE=output/history.json

# ---- 推送渠道（留空=关闭该渠道，自动跳过）----
WECOM_WEBHOOK=                     # 企业微信机器人 webhook 完整地址
DINGTALK_WEBHOOK=                  # 钉钉机器人 webhook 完整地址
DINGTALK_SECRET=                   # 钉钉加签密钥（可选）
FEISHU_WEBHOOK=                    # 飞书机器人 webhook 完整地址
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                         # 默认取 SMTP_USER
EMAIL_TO=                          # 收件人，逗号分隔

# ---- 网络代理（可选）：国内 IP 访问境外源用，留空=不走代理 ----
# 邮件（SMTP）不走代理；HTTP(S) 采集会自动套用此代理。
PROXY_HTTP=
PROXY_HTTPS=

# ---- 输出与调度 ----
OUTPUT_DIR=output
SCHEDULE_TIME=07:30                # 工作日定时运行时刻（24h）
LOG_LEVEL=INFO
HTTP_TIMEOUT=20
